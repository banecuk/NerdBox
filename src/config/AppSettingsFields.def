// X-macro field list for AppSettings.
//
// Included twice: once by AppSettings.h to generate the struct members
// (AS_FIELD expands to a member declaration + initialiser), and once by
// WebServerService::handleConfig() to generate the /config dump (AS_FIELD
// expands to a SEND_CONFIG_<kind> call). Adding a tuning constant means
// adding exactly one line here — both consumers pick it up automatically.
//
// AS_FIELD(kind, type, name, initialiser)
//   kind: U (unsigned/integral, printed as %lu), F (float, %.3f),
//         B (bool, true/false), S (const char*, %s)
//
// uiBrightnessLevels (const uint8_t*, an array pointer) is deliberately not
// listed here — it needs its own per-element dump and is handled by hand in
// both AppSettings.h and handleConfig().

AS_FIELD(U, uint32_t, debugSerialBaudRate, AppConfig::internal::DebugImpl::kSerialBaudRate)
AS_FIELD(U, uint32_t, debugSerialTimeoutMs, AppConfig::internal::DebugImpl::kSerialTimeoutMs)
AS_FIELD(B, bool, debugWaitForSerial, AppConfig::internal::DebugImpl::kWaitForSerial)

AS_FIELD(U, uint8_t, initNetworkRetries, AppConfig::internal::InitImpl::kDefaultNetworkRetries)
AS_FIELD(U, uint32_t, initNetworkRetryDelayMs, AppConfig::internal::InitImpl::kNetworkRetryDelayMs)
AS_FIELD(U, uint8_t, initTimeSyncRetries, AppConfig::internal::InitImpl::kDefaultTimeSyncRetries)
AS_FIELD(U, uint32_t, initTimeSyncBaseDelayMs,
         AppConfig::internal::InitImpl::kTimeSyncRetryDelayBaseMs)
AS_FIELD(U, uint16_t, initBackoffJitterMs, AppConfig::internal::InitImpl::kBackoffJitterMs)

AS_FIELD(U, unsigned long, watchdogTimeoutMs, AppConfig::internal::WatchdogImpl::kTimeoutMs)
AS_FIELD(B, bool, watchdogEnableOnBoot, AppConfig::internal::WatchdogImpl::kEnableOnBoot)

AS_FIELD(U, uint32_t, timingScreenTaskMs, AppConfig::internal::TimingImpl::kScreenTaskMs)
AS_FIELD(U, uint32_t, timingBackgroundTaskMs, AppConfig::internal::TimingImpl::kBackgroundTaskMs)
AS_FIELD(U, uint32_t, timingMainLoopMs, AppConfig::internal::TimingImpl::kMainLoopMs)

AS_FIELD(U, uint32_t, tasksScreenStack, AppConfig::internal::TasksImpl::kScreenStack)
AS_FIELD(U, uint32_t, tasksBackgroundStack, AppConfig::internal::TasksImpl::kBackgroundStack)
AS_FIELD(U, uint32_t, tasksScreenPriority, AppConfig::internal::TasksImpl::kScreenPriority)
AS_FIELD(U, uint32_t, tasksBackgroundPriority, AppConfig::internal::TasksImpl::kBackgroundPriority)

AS_FIELD(U, uint32_t, hardwareMonitorRefreshMs,
         AppConfig::internal::HardwareMonitorImpl::kRefreshMs)
AS_FIELD(U, uint32_t, hardwareMonitorThreadsRefreshMs,
         AppConfig::internal::HardwareMonitorImpl::kThreadsRefreshMs)
AS_FIELD(U, uint32_t, hardwareMonitorFailureRefreshMs,
         AppConfig::internal::HardwareMonitorImpl::kRefreshAfterFailureMs)
AS_FIELD(U, uint32_t, hardwareMonitorRetryDelayMs,
         AppConfig::internal::HardwareMonitorImpl::kRetryDelayMs)
AS_FIELD(U, uint32_t, hardwareMonitorMaxRetries,
         AppConfig::internal::HardwareMonitorImpl::kMaxRetries)
AS_FIELD(F, float, hardwareMonitorThreadsUpwardSmoothing,
         AppConfig::internal::HardwareMonitorImpl::kThreadsUpwardSmoothing)
AS_FIELD(F, float, hardwareMonitorThreadsDownwardSmoothing,
         AppConfig::internal::HardwareMonitorImpl::kThreadsDownwardSmoothing)
AS_FIELD(B, bool, hardwareMonitorThreadsStaggerEnabled,
         AppConfig::internal::HardwareMonitorImpl::kThreadsStaggerEnabled)
AS_FIELD(F, float, hardwareMonitorThreadsStaggerFraction,
         AppConfig::internal::HardwareMonitorImpl::kThreadsStaggerFraction)
AS_FIELD(U, uint32_t, hardwareMonitorThreadsStaggerFallbackPeriodMs,
         AppConfig::internal::HardwareMonitorImpl::kThreadsStaggerFallbackPeriodMs)
AS_FIELD(U, uint32_t, hardwareMonitorThreadsStaggerMinPeriodMs,
         AppConfig::internal::HardwareMonitorImpl::kThreadsStaggerMinPeriodMs)
AS_FIELD(U, uint32_t, hardwareMonitorThreadsStaggerMaxPeriodMs,
         AppConfig::internal::HardwareMonitorImpl::kThreadsStaggerMaxPeriodMs)

AS_FIELD(U, uint32_t, airQualityFailureBackoffMs,
         AppConfig::internal::AirQualityImpl::kFailureBackoffMs)

AS_FIELD(U, uint32_t, weatherRefreshIntervalMs,

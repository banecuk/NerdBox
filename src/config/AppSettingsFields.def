AS_FIELD(U, uint8_t, uiDimAtNightEndHour, AppConfig::internal::UiImpl::kDimAtNightEndHour)
AS_FIELD(U, uint8_t, uiDimAtNightPercent, AppConfig::internal::UiImpl::kDimAtNightPercent)
